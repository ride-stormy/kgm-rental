{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../../.. && pnpm install --frozen-lockfile && pnpm turbo build --filter=@kgm-rental/backend-b2c"
  },
  "deploy": {
    "startCommand": "node apps/backend/b2c/dist/main.js",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
